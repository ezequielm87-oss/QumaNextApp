# Neon Postgres (or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_SECRET="generate-a-random-32+char-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini (usado por /api/ai/invoke para el módulo de IA)
GEMINI_API_KEY=""
# Opcional, default: gemini-flash-latest
GEMINI_MODEL="gemini-flash-latest"

# Resend (usado por /api/auth/forgot-password para el email de recuperación)
RESEND_API_KEY=""
# Opcional. Sin dominio verificado en Resend, usar el default de pruebas:
RESEND_FROM_EMAIL="QUMA Finance <onboarding@resend.dev>"
